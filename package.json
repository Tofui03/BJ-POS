{
  "name": "borneo-jasa-pos",
  "version": "0.0.0",
  "private": true,
  "description": "Borneo Jasa Sdn. Bhd. POS — offline-first desktop till (Vue 3 SPA, wrapper-agnostic)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/pos",
    "build": "npm run build --workspace=apps/pos",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
