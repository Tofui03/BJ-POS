# ---------------------------------------------------------------------------
# Borneo Jasa POS — till secrets (never commit the real .env)
# ---------------------------------------------------------------------------
# Where the app looks for `.env` (first hit wins):
#   1. the app's user-data dir (Windows: %APPDATA%\borneo-jasa-pos\.env)
#   2. next to the installed executable
#   3. the working directory (development)
#
# Close Day uploads the daily Excel workbook to Google Drive (v1).
# Installer sets these once; the cashier never touches them.
#
# 1. Create a Google Cloud service account with Drive access
# 2. Share the shop Drive folder with that service account email
# 3. Put the folder id + JSON key path below

DRIVE_FOLDER_ID=your-shared-folder-id
DRIVE_SERVICE_ACCOUNT_FILE=C:\Program Files\Borneo Jasa POS\drive-service-account.json
# Or paste the JSON inline instead of a file:
#DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..." }

# ---------------------------------------------------------------------------
# Legacy email delivery (optional — not used by Borneo Jasa v1 Close Day)
# ---------------------------------------------------------------------------
#SMTP_USER=pos@example.com
#SMTP_PASS=abcdefghijklmnop
#SMTP_HOST=mail.example.com
#SMTP_PORT=465
