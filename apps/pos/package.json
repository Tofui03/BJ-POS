{
  "name": "@yf/pos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Borneo Jasa Sdn. Bhd. POS — Vue 3 SPA till (wrapper-agnostic).",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "electron:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:better-sqlite3 --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "electron:build": "vue-tsc --noEmit && vite build && corepack pnpm electron:main",
    "dist:win": "corepack pnpm electron:build && electron-builder --win --publish never",
    "dist:linux": "corepack pnpm electron:build && electron-builder --linux --publish never",
    "dist:mac": "corepack pnpm electron:build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.borneojasa.pos",
    "productName": "Borneo Jasa POS",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "perMachine": true,
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "executableName": "borneo-jasa-pos",
      "category": "Office",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@yf/core": "workspace:*",
    "@yf/data": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "dayjs": "^1.11.21",
    "idb-keyval": "^6.2.1",
    "lucide-vue-next": "^1.0.0",
    "nodemailer": "^9.0.3",
    "pinia": "^2.2.0",
    "sql.js": "^1.12.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^8.0.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "unocss": "^0.63.0",
    "unocss-preset-animations": "^1.3.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
